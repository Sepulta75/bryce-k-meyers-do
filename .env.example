# ---------------------------------------------------------------------------
# Dr. Bryce K. Meyers — site configuration
#
# Vite only exposes variables prefixed with VITE_ to the browser. Copy this file
# to `.env.local` for local work; set the same names as build-time env vars in
# CI (GitHub Actions) or as Docker build args.
#
# Every connector ships DISABLED. Nothing is transmitted until you flip
# VITE_TELEGRAM_ENABLED to "true" and give it a transport.
# ---------------------------------------------------------------------------

# Master switch for the Telegram connector.
VITE_TELEGRAM_ENABLED=false

# Transport for the Telegram connector:
#   proxy  (recommended) — POST to your own endpoint; the bot token stays server-side
#   direct              — call api.telegram.org from the browser; token is PUBLIC
VITE_TELEGRAM_MODE=proxy

# Used when VITE_TELEGRAM_MODE=proxy. Your relay accepts
# { channel, chatId, subject, text, replyTo } as JSON.
VITE_TELEGRAM_PROXY_URL=

# Used when VITE_TELEGRAM_MODE=direct. NEVER ship a real token in a public build:
# anyone can read it out of the bundle and post as your bot.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# What the contact form points people at while no connector is live.
# phone → shows the clinic phone number in the acknowledgement
# none  → shows no fallback
VITE_CONTACT_FALLBACK=phone

# Base path for the built site. Leave unset for Render/local (served at "/").
# GitHub Pages project sites need "/<repo-name>/" — CI sets this automatically.
# VITE_SITE_BASE=/
