{
  "name": "bryce-k-meyers-do",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Landing page for Bryce K. Meyers, DO, MPH, FAAFP, CMRO — Vite + TypeScript + Tailwind, clean architecture, pluggable messaging connectors.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && vite build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
